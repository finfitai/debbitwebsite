# =============================================================================
# debbit OS Dashboard (Next.js) — Environment Variables
# Copy to .env.local for local dev. Add as Vercel env vars for production.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — server-side only, never exposed to the client. Used by
# pages/api/webhooks/clerk.js to keep the external_auth_id-linked `users` row
# in sync on sign-up/profile update/delete (no user JWT exists in a webhook
# for RLS to key off, so this is the one place that legitimately needs it).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
# From Clerk dashboard → Webhooks, used by pages/api/webhooks/clerk.js to verify signatures.
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002

# ── Stripe (subscription billing) ───────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# From Stripe dashboard → Webhooks, used by pages/api/webhooks/stripe.js to verify signatures.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# The recurring Price id (price_...) checkout.js subscribes a business to.
STRIPE_PRICE_ID=price_your_recurring_price_id_here

# ── Welcome email (pages/api/webhooks/clerk.js) ─────────────────────────────
GMAIL_USER=your-app@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# Staging environment (set to 'staging' or 'production')
NEXT_PUBLIC_ENV=production
# Staging Supabase (for dev/staging tier)
# SUPABASE_URL_STAGING=https://xxx-staging.supabase.co
# SUPABASE_ANON_KEY_STAGING=eyJ...
